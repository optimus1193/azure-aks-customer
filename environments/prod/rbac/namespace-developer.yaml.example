# Rename to .yaml to apply. Files in this folder are applied by the platform's 02-platform stage when features.rbac_manifests is true.
# Subjects are Entra ID group object IDs (with Azure RBAC, Kubernetes RBAC still applies on top).
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: namespace-developer
rules:
  - apiGroups: ["", "apps", "batch", "autoscaling"]
    resources: ["pods", "pods/log", "pods/portforward", "services", "configmaps", "deployments", "replicasets", "statefulsets", "jobs", "cronjobs", "horizontalpodautoscalers"]
    verbs: ["get", "list", "watch", "create", "update", "patch", "delete"]
  - apiGroups: [""]
    resources: ["secrets"]
    verbs: ["list"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: myapp-developers
  namespace: myapp
subjects:
  - kind: Group
    name: "22222222-2222-2222-2222-222222222222" # Entra group: AKS-Developers
    apiGroup: rbac.authorization.k8s.io
roleRef:
  kind: ClusterRole
  name: namespace-developer
  apiGroup: rbac.authorization.k8s.io
